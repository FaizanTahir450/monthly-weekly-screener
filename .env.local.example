NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional feed-backed scan universes.
# Format: SYMBOL, SYMBOLUSDT, or SYMBOLUSDT:Display Name:MarketCapRank
RECENTLY_LISTED_SYMBOLS=
EVENT_COIN_SYMBOLS=
SOCIAL_TREND_SYMBOLS=

# Optional scan pacing and retry behavior.
SCAN_CONCURRENCY=16
MULTI_EXCHANGE_SCAN_CONCURRENCY=2
EXCHANGE_FETCH_RETRIES=6
EXCHANGE_RETRY_DELAY_MS=1500
MULTI_EXCHANGE_ALLOW_PARTIAL=false
OKX_REST_BASE_URL=https://openapi.okx.com
BINANCE_SPOT_BASE_URLS=https://data-api.binance.vision,https://api.binance.com,https://api-gcp.binance.com,https://api1.binance.com,https://api2.binance.com,https://api3.binance.com,https://api4.binance.com
